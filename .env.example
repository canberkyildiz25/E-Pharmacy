# Nobet runs with none of these set: it then keeps accounts, shelves and
# orders in the visitor's browser, which is how the public demonstration runs.

# The address the site is served from. On Vercel it is worked out without
# this; set it for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# To keep accounts, pharmacies and orders in MongoDB, set both of these.
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
# A long random string, at least 32 characters, used to sign sessions.
# NOBET_SECRET=
# The database name. "nobet" if left out.
# MONGODB_DB=nobet
# The address of the one account that oversees the platform. Whoever joins
# with it is the administrator.
# NOBET_ADMIN=admin@example.com

# To try the server side with no database installed: everything is kept in
# the server's memory and is gone when it stops.
# NOBET_DB=memory
